# Copy to .env (never commit .env).
# Fixture mode: 1 = use labelled fixture data and a fake local sign-in (no backend needed). 0 = real backend handoff.
EXPO_PUBLIC_USE_FIXTURES=1
# Backend address. Android emulator reaches the host machine at 10.0.2.2.
# Physical phone: run `adb reverse tcp:8080 tcp:8080` and use http://localhost:8080, or use your PC's LAN IP.
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8080
