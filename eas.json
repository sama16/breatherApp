{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_FIXTURES": "1"
      }
    },
    "preview-real": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_FIXTURES": "0"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-ios-simulator": {
      "developmentClient": true,
      "ios": {
        "simulator": true
      }
    }
  }
}
